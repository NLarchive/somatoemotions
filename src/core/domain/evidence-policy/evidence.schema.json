{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "review_method": {
      "const": "source-based editorial audit"
    },
    "human_certification": {
      "const": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "review_method": {
            "const": "source-based editorial audit"
          }
        },
        "required": [
          "id",
          "title",
          "authors",
          "year",
          "url",
          "type",
          "scope",
          "limitations",
          "accessed",
          "review_method"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "review_method",
    "human_certification",
    "sources"
  ],
  "additionalProperties": false
}
