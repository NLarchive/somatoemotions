{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "images": {
      "type": "object",
      "patternProperties": {
        "^(somatic|face|action)/[a-z0-9][a-z0-9_-]*$": {
          "type": "object",
          "properties": {
            "webp": {
              "type": "string",
              "minLength": 1
            },
            "jpg": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "alt": {
              "type": "string",
              "minLength": 10
            },
            "provenance": {
              "const": "AI-generated illustration"
            },
            "review_status": {
              "enum": [
                "technical",
                "visual_checked"
              ]
            }
          },
          "required": [
            "webp",
            "jpg",
            "width",
            "height",
            "alt",
            "provenance",
            "review_status"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "images"
  ],
  "additionalProperties": false
}
