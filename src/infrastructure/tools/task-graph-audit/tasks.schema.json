{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project",
    "tasks",
    "enums",
    "project_structure",
    "unit_registry",
    "categories",
    "workers",
    "navigation"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "start_date",
        "end_date",
        "status",
        "timezone",
        "currency",
        "project_manager"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string"
        },
        "project_manager": {
          "type": "object"
        },
        "status": {
          "enum": [
            "Not Started",
            "Planning",
            "In Progress",
            "On Hold",
            "Completed",
            "Cancelled"
          ]
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "task_name",
          "start_date",
          "end_date",
          "due_date",
          "priority",
          "status",
          "progress_percentage",
          "target_unit",
          "path_node_id",
          "unit_bindings",
          "verification",
          "acceptance_criteria",
          "dependencies"
        ],
        "properties": {
          "task_id": {
            "type": "integer",
            "minimum": 1
          },
          "task_name": {
            "type": "string",
            "minLength": 1
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "due_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "priority": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low"
            ]
          },
          "status": {
            "enum": [
              "Not Started",
              "In Progress",
              "Blocked",
              "In Review",
              "Done",
              "Cancelled"
            ]
          },
          "progress_percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "estimated_hours": {
            "type": "number",
            "minimum": 0
          },
          "target_unit": {
            "type": "string"
          },
          "path_node_id": {
            "type": "string"
          },
          "unit_bindings": {
            "type": "object"
          },
          "verification": {
            "type": "object"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "predecessor_task_id",
                "type",
                "lag_days"
              ],
              "properties": {
                "predecessor_task_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "type": {
                  "enum": [
                    "FS",
                    "SS",
                    "FF",
                    "SF"
                  ]
                },
                "lag_days": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "enums": {
      "type": "object"
    },
    "project_structure": {
      "type": "object"
    },
    "unit_registry": {
      "type": "array"
    },
    "categories": {
      "type": "array"
    },
    "workers": {
      "type": "array"
    },
    "navigation": {
      "type": "object"
    }
  }
}
